# Environment Variables for the Imoveglobal Next.js app
# Copy this file to .env.local and fill in real values.
# These are client-exposed (NEXT_PUBLIC_*) — they are baked into the browser
# bundle, matching the original Vite app. The token is a soft spam guard for
# the Google Apps Script endpoint, not a secret.

# Google Apps Script Web App URL
# Example: https://script.google.com/macros/s/AKfycby...xyz/exec
NEXT_PUBLIC_FORM_SCRIPT_URL=YOUR_GOOGLE_SCRIPT_URL_HERE

# Security token (must match Google Apps Script CONFIG.SECRET_TOKEN)
NEXT_PUBLIC_FORM_SUBMISSION_TOKEN=YOUR_FORM_TOKEN_HERE
